# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Modo Teste ou Produção)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Resend (E-mails transacionais)
RESEND_API_KEY=

# WhatsApp Business API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# n8n Automações
N8N_WEBHOOK_BASE_URL=
N8N_SHARED_SECRET=

# Painel Admin URL
ADMIN_BASE_URL=http://localhost:3001

# Build-time: alterar exige novo build
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEMO_WATERMARK=true
NEXT_PUBLIC_WATERMARK_TEXT="DEMONSTRAÇÃO · SUA MARCA"
NEXT_PUBLIC_WATERMARK_CONTACT=

# Web Push: public key ONLY. Rebuild required after changing it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY, VAPID_SUBJECT and BOOKING_WEBHOOK_SECRET belong ONLY
# in Supabase Edge Function secrets. See docs/NOTIFICACOES-PUSH.md.
