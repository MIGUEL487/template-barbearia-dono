{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "auto-stilo-dono",
  "compatibility_date": "2025-08-01",
  "main": ".open-next/worker.js",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_BASE_URL": "http://localhost:3001"
  }
}
